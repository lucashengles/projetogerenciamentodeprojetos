n/* cyrillic-ext */\n@font-face {\n  font-family: 'Plus Jakarta Sans';\n  font-style: normal;\n  font-weight: 700;\n  font-display: swap;\n  src: url(\"1527233c-5b4c-446e-9fb2-e3ac90c9b178\") format('woff2');\n  unicode-range: U+0460-052F, U+1C80-1C8A, U+20B4, U+2DE0-2DFF, U+A640-A69F, U+FE2E-FE2F;\n}\n/* vietnamese */\n@font-face {\n  font-family: 'Plus Jakarta Sans';\n  font-style: normal;\n  font-weight: 700;\n  font-display: swap;\n  src: url(\"6bc88a0b-8156-4405-b138-847af0deaf2c\") format('woff2');\n  unicode-range: U+0102-0103, U+0110-0111, U+0128-0129, U+0168-0169, U+01A0-01A1, U+01AF-01B0, U+0300-0301, U+0303-0304, U+0308-0309, U+0323, U+0329, U+1EA0-1EF9, U+20AB;\n}\n/* latin-ext */\n@font-face {\n  font-family: 'Plus Jakarta Sans';\n  font-style: normal;\n  font-weight: 700;\n  font-display: swap;\n  src: url(\"9877751e-7921-49cc-93d1-398c18ab9209\") format('woff2');\n  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;\n}\n/* latin */\n@font-face {\n  font-family: 'Plus Jakarta Sans';\n  font-style: normal;\n  font-weight: 700;\n  font-display: swap;\n  src: url(\"22cdd77d-3c03-41bd-a5f9-e9d65a3f728d\") format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n/* cyrillic-ext */\n@font-face {\n  font-family: 'Plus Jakarta Sans';\n  font-style: normal;\n  font-weight: 800;\n  font-display: swap;\n  src: url(\"1527233c-5b4c-446e-9fb2-e3ac90c9b178\") format('woff2');\n  unicode-range: U+0460-052F, U+1C80-1C8A, U+20B4, U+2DE0-2DFF, U+A640-A69F, U+FE2E-FE2F;\n}\n/* vietnamese */\n@font-face {\n  font-family: 'Plus Jakarta Sans';\n  font-style: normal;\n  font-weight: 800;\n  font-display: swap;\n  src: url(\"6bc88a0b-8156-4405-b138-847af0deaf2c\") format('woff2');\n  unicode-range: U+0102-0103, U+0110-0111, U+0128-0129, U+0168-0169, U+01A0-01A1, U+01AF-01B0, U+0300-0301, U+0303-0304, U+0308-0309, U+0323, U+0329, U+1EA0-1EF9, U+20AB;\n}\n/* latin-ext */\n@font-face {\n  font-family: 'Plus Jakarta Sans';\n  font-style: normal;\n  font-weight: 800;\n  font-display: swap;\n  src: url(\"9877751e-7921-49cc-93d1-398c18ab9209\") format('woff2');\n  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;\n}\n/* latin */\n@font-face {\n  font-family: 'Plus Jakarta Sans';\n  font-style: normal;\n  font-weight: 800;\n  font-display: swap;\n  src: url(\"22cdd77d-3c03-41bd-a5f9-e9d65a3f728d\") format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n<\u002Fstyle>\n<style>\n  html,body{margin:0;padding:0;background:#FBE9F2;}\n  *{box-sizing:border-box;-webkit-tap-highlight-color:transparent;}\n  ::-webkit-scrollbar{width:8px;height:8px;}\n  ::-webkit-scrollbar-thumb{background:#E9C6D8;border-radius:999px;}\n  @keyframes am-in{from{opacity:0;transform:translateY(10px) scale(.98);}to{opacity:1;transform:none;}}\n  @keyframes am-dot{0%,60%,100%{transform:translateY(0);opacity:.5;}30%{transform:translateY(-5px);opacity:1;}}\n  @keyframes am-pop{0%{transform:scale(.6);opacity:0;}60%{transform:scale(1.15);}100%{transform:scale(1);opacity:1;}}\n  @keyframes am-spin{to{transform:rotate(360deg);}}\n  @keyframes am-float{0%,100%{transform:translateY(0);}50%{transform:translateY(-8px);}}\n  @keyframes am-shine{0%{background-position:-120% 0;}100%{background-position:220% 0;}}\n  textarea{font-family:inherit;}\n<\u002Fstyle>\n<script src=\"658d4f6e-6d29-481c-a251-a344b1b04bbc\"><\u002Fscript>\n<script src=\"cda00e89-fdba-4ce8-82ef-39aa6178ccc8\"><\u002Fscript>\n<script>\n/* Ponte de IA para produção. No ambiente de design, window.claude já existe e este bloco é ignorado.\n   Publicado na Vercel, ele direciona as chamadas de IA para a função serverless /api/complete,\n   que guarda a chave da IA em segredo no servidor. Se a chamada falhar, o app usa os fallbacks automáticos. */\n(function(){\n  if (window.claude && typeof window.claude.complete === 'function') return;\n  window.claude = {\n    complete: async function(prompt){\n      const r = await fetch('/api/complete', {\n        method: 'POST',\n        headers: { 'Content-Type': 'application/json' },\n        body: JSON.stringify({ prompt: prompt })\n      });\n      if (!r.ok) throw new Error('api ' + r.status);\n      const data = await r.json();\n      if (data && typeof data.text === 'string') return data.text;\n      throw new Error('resposta inválida');\n    }\n  };\n})();\n<\u002Fscript>\n<\u002Fhelmet>\n\n<div style=\"min-height:100dvh;width:100%;display:flex;justify-content:center;align-items:stretch;background:radial-gradient(120% 80% at 50% 0%, #FFF1F8 0%, #FBE9F2 45%, #F3E8FF 100%);font-family:'Plus Jakarta Sans',system-ui,sans-serif;color:#2A1A24;\">\n  <div style=\"position:relative;width:100%;max-width:680px;min-height:100dvh;display:flex;flex-direction:column;background:#FFFFFF;box-shadow:0 30px 80px -30px rgba(190,24,93,.35);overflow:hidden;\">\n\n    <sc-if value=\"{{ showHeader }}\" hint-placeholder-val=\"{{ true }}\">\n      <div style=\"padding:16px 18px 14px;border-bottom:1px solid #F4E3EC;background:#FFFFFF;z-index:5;\">\n        <div style=\"display:flex;align-items:center;gap:11px;\">\n          <div style=\"width:40px;height:40px;border-radius:13px;background:linear-gradient(135deg,#F472B6,#DB2777);display:flex;align-items:center;justify-content:center;font-size:22px;box-shadow:0 6px 16px -4px rgba(219,39,119,.5);\">🦊<\u002Fdiv>\n          <div style=\"display:flex;flex-direction:column;line-height:1.05;\">\n            <span style=\"font-family:'Bricolage Grotesque',sans-serif;font-weight:800;font-size:18px;letter-spacing:-.02em;\">Meu Projeto<\u002Fspan>\n            <span style=\"font-size:12px;color:#A8889A;font-weight:600;\">com o Ágil 🦊<\u002Fspan>\n          <\u002Fdiv>\n          <div style=\"margin-left:auto;display:flex;align-items:center;gap:6px;background:linear-gradient(135deg,#FFF4DE,#FFE9C2);border:1px solid #F6D58A;padding:7px 12px;border-radius:999px;\">\n            <span style=\"font-size:14px;\">⭐<\u002Fspan>\n            <span style=\"font-family:'Bricolage Grotesque',sans-serif;font-weight:800;font-size:15px;color:#A86A12;\">{{ points }}<\u002Fspan>\n            <span style=\"font-size:11px;font-weight:700;color:#C08A38;\">clareza<\u002Fspan>\n          <\u002Fdiv>\n        <\u002Fdiv>\n        <div style=\"margin-top:14px;height:8px;border-radius:999px;background:#F4E3EC;overflow:hidden;\">\n          <div style=\"{{ barFillStyle }}\"><\u002Fdiv>\n        <\u002Fdiv>\n        <div style=\"margin-top:9px;display:flex;justify-content:space-between;gap:4px;\">\n          <sc-for list=\"{{ stages }}\" as=\"st\" hint-placeholder-count=\"4\">\n            <div style=\"display:flex;flex-direction:column;align-items:center;gap:3px;flex:1;min-width:0;\">\n              <div style=\"{{ st.dotStyle }}\">{{ st.icon }}<\u002Fdiv>\n              <span style=\"{{ st.labelStyle }}\">{{ st.label }}<\u002Fspan>\n            <\u002Fdiv>\n          <\u002Fsc-for>\n        <\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fsc-if>\n\n    <sc-if value=\"{{ isWelcome }}\" hint-placeholder-val=\"{{ true }}\">\n      <div style=\"flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:32px 26px 40px;gap:6px;\">\n        <div style=\"width:108px;height:108px;border-radius:34px;background:linear-gradient(135deg,#F9A8D4,#DB2777 70%);display:flex;align-items:center;justify-content:center;font-size:58px;box-shadow:0 22px 50px -16px rgba(219,39,119,.6);animation:am-float 4s ease-in-out infinite;\">🦊<\u002Fdiv>\n        <div style=\"margin-top:8px;display:inline-flex;align-items:center;gap:7px;background:#FCE7F0;color:#BE185D;font-weight:700;font-size:12.5px;padding:6px 13px;border-radius:999px;\">✨ Seu mentor de projetos<\u002Fdiv>\n        <h1 style=\"font-family:'Bricolage Grotesque',sans-serif;font-weight:800;font-size:32px;line-height:1.08;letter-spacing:-.025em;margin:14px 0 0;max-width:15ch;text-wrap:balance;\">Transforme sua ideia num plano de ação<\u002Fh1>\n        <p style=\"font-size:16px;line-height:1.5;color:#6E5764;margin:14px 0 0;max-width:34ch;text-wrap:pretty;\">Converse comigo numa boa e, em ~5 minutos, você sai com um PDF pronto pra executar. Sem jargão, sem cadastro. 🙌<\u002Fp>\n        <button onclick=\"{{ onStart }}\" style=\"margin-top:26px;border:none;cursor:pointer;background:linear-gradient(135deg,#EC4899,#BE185D);color:#fff;font-family:'Bricolage Grotesque',sans-serif;font-weight:700;font-size:18px;padding:16px 34px;border-radius:18px;box-shadow:0 16px 34px -10px rgba(190,24,93,.65);transition:transform .15s ease;\" style-hover=\"transform:translateY(-2px) scale(1.02);\" style-active=\"transform:scale(.97);\">Começar agora 🚀<\u002Fbutton>\n        <div style=\"margin-top:18px;display:flex;flex-wrap:wrap;gap:8px 14px;justify-content:center;font-size:12.5px;color:#A8889A;font-weight:600;\">\n          <span>✅ Grátis<\u002Fspan><span>🔓 Sem login<\u002Fspan><span>📱 Funciona no celular<\u002Fspan><span>⚡ ~5 minutos<\u002Fspan>\n        <\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fsc-if>\n\n    <sc-if value=\"{{ isChat }}\" hint-placeholder-val=\"{{ true }}\">\n      <div ref=\"{{ scrollRef }}\" style=\"flex:1;overflow-y:auto;padding:22px 18px 12px;display:flex;flex-direction:column;gap:14px;\">\n        <sc-for list=\"{{ messagesView }}\" as=\"m\" hint-placeholder-count=\"0\">\n\n          <sc-if value=\"{{ m.isAssistant }}\" hint-placeholder-val=\"{{ false }}\">\n            <div style=\"display:flex;gap:10px;align-items:flex-end;max-width:90%;animation:am-in .3s ease both;\">\n              <div style=\"flex:none;width:34px;height:34px;border-radius:11px;background:linear-gradient(135deg,#F472B6,#DB2777);display:flex;align-items:center;justify-content:center;font-size:18px;box-shadow:0 4px 10px -3px rgba(219,39,119,.5);\">🦊<\u002Fdiv>\n              <div style=\"background:#FBEAF2;color:#4A2A38;padding:12px 15px;border-radius:18px 18px 18px 5px;font-size:15px;line-height:1.5;font-weight:500;text-wrap:pretty;\">{{ m.text }}<\u002Fdiv>\n            <\u002Fdiv>\n          <\u002Fsc-if>\n\n          <sc-if value=\"{{ m.isTyping }}\" hint-placeholder-val=\"{{ false }}\">\n            <div style=\"display:flex;gap:10px;align-items:flex-end;animation:am-in .3s ease both;\">\n              <div style=\"flex:none;width:34px;height:34px;border-radius:11px;background:linear-gradient(135deg,#F472B6,#DB2777);display:flex;align-items:center;justify-content:center;font-size:18px;\">🦊<\u002Fdiv>\n              <div style=\"background:#FBEAF2;padding:15px 17px;border-radius:18px 18px 18px 5px;display:flex;gap:5px;\">\n                <span style=\"width:8px;height:8px;border-radius:50%;background:#DB2777;display:inline-block;animation:am-dot 1.1s infinite;\"><\u002Fspan>\n                <span style=\"width:8px;height:8px;border-radius:50%;background:#DB2777;display:inline-block;animation:am-dot 1.1s infinite .18s;\"><\u002Fspan>\n                <span style=\"width:8px;height:8px;border-radius:50%;background:#DB2777;display:inline-block;animation:am-dot 1.1s infinite .36s;\"><\u002Fspan>\n              <\u002Fdiv>\n            <\u002Fdiv>\n          <\u002Fsc-if>\n\n          <sc-if value=\"{{ m.isUser }}\" hint-placeholder-val=\"{{ false }}\">\n            <div style=\"align-self:flex-end;max-width:88%;background:linear-gradient(135deg,#EC4899,#BE185D);color:#fff;padding:12px 15px;border-radius:18px 18px 5px 18px;font-size:15px;line-height:1.5;font-weight:600;box-shadow:0 8px 18px -8px rgba(190,24,93,.55);animation:am-in .3s ease both;text-wrap:pretty;\">{{ m.text }}<\u002Fdiv>\n          <\u002Fsc-if>\n\n          <sc-if value=\"{{ m.isReveal }}\" hint-placeholder-val=\"{{ false }}\">\n            <div style=\"align-self:stretch;border-radius:22px;overflow:hidden;border:1.5px solid #F3C9DD;box-shadow:0 16px 36px -16px rgba(190,24,93,.4);animation:am-pop .5s ease both;\">\n              <div style=\"padding:18px 20px;background:linear-gradient(135deg,#7C3AED,#DB2777);color:#fff;display:flex;align-items:center;gap:14px;\">\n                <div style=\"width:54px;height:54px;border-radius:16px;background:rgba(255,255,255,.18);display:flex;align-items:center;justify-content:center;font-size:30px;flex:none;\">{{ m.emoji }}<\u002Fdiv>\n                <div style=\"line-height:1.15;\">\n                  <div style=\"font-size:12px;font-weight:700;opacity:.85;letter-spacing:.06em;text-transform:uppercase;\">Metodologia ideal pra você<\u002Fdiv>\n                  <div style=\"font-family:'Bricolage Grotesque',sans-serif;font-weight:800;font-size:24px;letter-spacing:-.02em;\">{{ m.methodName }}<\u002Fdiv>\n                <\u002Fdiv>\n              <\u002Fdiv>\n              <div style=\"padding:16px 20px;background:#fff;font-size:14.5px;line-height:1.55;color:#4A2A38;font-weight:500;text-wrap:pretty;\">{{ m.why }}<\u002Fdiv>\n            <\u002Fdiv>\n          <\u002Fsc-if>\n\n          <sc-if value=\"{{ m.isEdu }}\" hint-placeholder-val=\"{{ false }}\">\n            <div style=\"align-self:stretch;display:flex;gap:10px;animation:am-in .35s ease both;\">\n              <div style=\"flex:none;width:34px;height:34px;border-radius:11px;background:linear-gradient(135deg,#A78BFA,#7C3AED);display:flex;align-items:center;justify-content:center;font-size:17px;box-shadow:0 4px 10px -3px rgba(124,58,237,.5);\">💡<\u002Fdiv>\n              <div style=\"flex:1;min-width:0;background:linear-gradient(180deg,#F6F0FF,#FCF8FF);border:1.5px solid #E6D9FB;border-radius:6px 18px 18px 18px;padding:13px 16px;\">\n                <div style=\"display:flex;align-items:center;gap:7px;margin-bottom:6px;flex-wrap:wrap;\">\n                  <span style=\"font-size:16px;\">{{ m.icon }}<\u002Fspan>\n                  <span style=\"font-family:'Bricolage Grotesque',sans-serif;font-weight:800;font-size:14.5px;color:#6D28D9;letter-spacing:-.01em;\">{{ m.title }}<\u002Fspan>\n                  <span style=\"margin-left:auto;font-size:9.5px;font-weight:800;color:#8B5CF6;letter-spacing:.05em;background:#EDE4FE;padding:3px 8px;border-radius:999px;white-space:nowrap;\">APRENDA RÁPIDO<\u002Fspan>\n                <\u002Fdiv>\n                <div style=\"font-size:13.5px;line-height:1.55;color:#4C3A66;font-weight:500;text-wrap:pretty;\">{{ m.body }}<\u002Fdiv>\n              <\u002Fdiv>\n            <\u002Fdiv>\n          <\u002Fsc-if>\n\n          <sc-if value=\"{{ m.isPhase }}\" hint-placeholder-val=\"{{ false }}\">\n            <div style=\"align-self:stretch;margin:8px 0 2px;animation:am-in .4s ease both;\">\n              <div style=\"display:flex;align-items:center;gap:10px;\">\n                <div style=\"flex:1;height:1px;background:linear-gradient(90deg,transparent,#F0CFE0);\"><\u002Fdiv>\n                <div style=\"display:flex;align-items:center;gap:7px;background:linear-gradient(135deg,#FCE7F0,#F3E8FF);border:1px solid #F0CFE0;padding:6px 13px;border-radius:999px;white-space:nowrap;\">\n                  <span style=\"font-size:14px;\">{{ m.icon }}<\u002Fspan>\n                  <span style=\"font-family:'Bricolage Grotesque',sans-serif;font-weight:800;font-size:12.5px;color:#BE185D;\">Etapa {{ m.step }}: {{ m.title }}<\u002Fspan>\n                <\u002Fdiv>\n                <div style=\"flex:1;height:1px;background:linear-gradient(90deg,#F0CFE0,transparent);\"><\u002Fdiv>\n              <\u002Fdiv>\n              <div style=\"margin:9px auto 0;max-width:90%;text-align:center;font-size:12.5px;line-height:1.5;color:#8A7081;font-weight:500;text-wrap:pretty;\">{{ m.body }}<\u002Fdiv>\n            <\u002Fdiv>\n          <\u002Fsc-if>\n\n        <\u002Fsc-for>\n      <\u002Fdiv>\n\n      <div style=\"border-top:1px solid #F4E3EC;background:#FFFFFF;padding:14px 16px calc(14px + env(safe-area-inset-bottom));\">\n        <sc-if value=\"{{ showChoices }}\" hint-placeholder-val=\"{{ false }}\">\n          <div style=\"display:flex;flex-wrap:wrap;gap:9px;\">\n            <sc-for list=\"{{ choices }}\" as=\"c\" hint-placeholder-count=\"0\">\n              <button onclick=\"{{ c.onClick }}\" style=\"cursor:pointer;border:1.5px solid #F1C6DA;background:#FFF5FA;color:#BE185D;font-weight:700;font-size:14.5px;padding:11px 16px;border-radius:14px;transition:all .12s ease;\" style-hover=\"background:#FCE7F0;border-color:#EC4899;transform:translateY(-1px);\" style-active=\"transform:scale(.96);\">{{ c.label }}<\u002Fbutton>\n            <\u002Fsc-for>\n          <\u002Fdiv>\n        <\u002Fsc-if>\n\n        <sc-if value=\"{{ showTextInput }}\" hint-placeholder-val=\"{{ false }}\">\n          <sc-if value=\"{{ hasGuide }}\" hint-placeholder-val=\"{{ false }}\">\n            <div style=\"display:flex;align-items:flex-start;gap:8px;margin-bottom:10px;background:#FBF7FF;border:1px solid #ECE0FB;border-radius:12px;padding:9px 12px;\">\n              <span style=\"font-size:14px;flex:none;line-height:1.3;\">💬<\u002Fspan>\n              <div style=\"font-size:12.5px;line-height:1.45;color:#6D5A86;font-weight:500;\"><b style=\"color:#7C3AED;\">Como responder:<\u002Fb> {{ inputGuide }}<\u002Fdiv>\n            <\u002Fdiv>\n          <\u002Fsc-if>\n          <div style=\"display:flex;gap:9px;align-items:flex-end;\">\n            <textarea value=\"{{ draft }}\" oninput=\"{{ onDraft }}\" onkeydown=\"{{ onDraftKey }}\" rows=\"1\" placeholder=\"{{ inputPlaceholder }}\" style=\"flex:1;resize:none;border:1.5px solid #EEDCE6;border-radius:16px;padding:13px 15px;font-size:15px;line-height:1.4;color:#2A1A24;outline:none;max-height:130px;background:#FFFCFE;font-weight:500;\" style-focus=\"border-color:#EC4899;\"><\u002Ftextarea>\n            <button onclick=\"{{ onSend }}\" style=\"{{ sendStyle }}\">➤<\u002Fbutton>\n          <\u002Fdiv>\n          <div style=\"display:flex;align-items:center;gap:8px;margin-top:9px;\">\n            <div style=\"flex:1;height:5px;border-radius:999px;background:#F4E3EC;overflow:hidden;\"><div style=\"{{ detailBarStyle }}\"><\u002Fdiv><\u002Fdiv>\n            <span style=\"font-size:11px;font-weight:700;color:{{ detailColor }};white-space:nowrap;\">{{ detailLabel }}<\u002Fspan>\n          <\u002Fdiv>\n        <\u002Fsc-if>\n      <\u002Fdiv>\n    <\u002Fsc-if>\n\n    <sc-if value=\"{{ isFinish }}\" hint-placeholder-val=\"{{ true }}\">\n      <div style=\"flex:1;overflow-y:auto;display:flex;flex-direction:column;align-items:center;text-align:center;padding:30px 24px 40px;\">\n\n        <sc-if value=\"{{ generatingPlan }}\" hint-placeholder-val=\"{{ true }}\">\n          <div style=\"margin:auto;display:flex;flex-direction:column;align-items:center;gap:18px;\">\n            <div style=\"width:54px;height:54px;border-radius:50%;border:5px solid #FCE7F0;border-top-color:#DB2777;animation:am-spin .9s linear infinite;\"><\u002Fdiv>\n            <div style=\"font-family:'Bricolage Grotesque',sans-serif;font-weight:700;font-size:19px;\">Montando seu plano…<\u002Fdiv>\n            <div style=\"color:#8A7681;font-size:14px;max-width:26ch;\">Organizando tudo que você me contou num plano de ação de verdade 🛠️<\u002Fdiv>\n          <\u002Fdiv>\n        <\u002Fsc-if>\n\n        <sc-if value=\"{{ planReady }}\" hint-placeholder-val=\"{{ false }}\">\n          <div style=\"width:96px;height:96px;border-radius:30px;background:linear-gradient(135deg,#FBBF24,#F59E0B);display:flex;align-items:center;justify-content:center;font-size:50px;box-shadow:0 18px 40px -12px rgba(245,158,11,.6);animation:am-pop .6s ease both;\">🏆<\u002Fdiv>\n          <div style=\"margin-top:16px;display:inline-flex;align-items:center;gap:7px;background:#FEF3C7;color:#B45309;font-weight:800;font-size:12.5px;padding:6px 14px;border-radius:999px;letter-spacing:.03em;\">CONQUISTA DESBLOQUEADA<\u002Fdiv>\n          <h1 style=\"font-family:'Bricolage Grotesque',sans-serif;font-weight:800;font-size:28px;letter-spacing:-.02em;margin:14px 0 0;max-width:18ch;text-wrap:balance;\">Seu plano de ação está pronto!<\u002Fh1>\n          <p style=\"font-size:15px;line-height:1.5;color:#6E5764;margin:10px 0 0;max-width:32ch;text-wrap:pretty;\">Mapeei <b>{{ planName }}<\u002Fb> usando <b>{{ planMethod }}<\u002Fb>. Mandou bem demais! 🙌<\u002Fp>\n\n          <div style=\"margin-top:22px;display:flex;flex-wrap:wrap;gap:10px;justify-content:center;\">\n            <sc-for list=\"{{ badges }}\" as=\"b\" hint-placeholder-count=\"3\">\n              <div style=\"display:flex;align-items:center;gap:8px;background:#fff;border:1.5px solid #F3C9DD;padding:10px 14px;border-radius:14px;box-shadow:0 8px 20px -12px rgba(190,24,93,.4);animation:am-pop .5s ease both;\">\n                <span style=\"font-size:20px;\">{{ b.emoji }}<\u002Fspan>\n                <span style=\"font-weight:700;font-size:13.5px;color:#BE185D;\">{{ b.label }}<\u002Fspan>\n              <\u002Fdiv>\n            <\u002Fsc-for>\n          <\u002Fdiv>\n\n          <div style=\"margin-top:22px;width:100%;max-width:400px;background:linear-gradient(135deg,#FFF4DE,#FFE9C2);border:1px solid #F6D58A;border-radius:18px;padding:16px 18px;text-align:left;\">\n            <div style=\"display:flex;align-items:center;gap:10px;\">\n              <span style=\"font-size:26px;\">⭐<\u002Fspan>\n              <div style=\"line-height:1.1;\">\n                <div style=\"font-family:'Bricolage Grotesque',sans-serif;font-weight:800;font-size:22px;color:#A86A12;\">{{ points }} <span style=\"font-size:13px;font-weight:700;\">pts de clareza<\u002Fspan><\u002Fdiv>\n                <div style=\"font-size:12px;font-weight:700;color:#C08A38;\">Nível do plano: {{ planTier }}<\u002Fdiv>\n              <\u002Fdiv>\n              <div style=\"margin-left:auto;font-size:11px;font-weight:800;color:#fff;background:{{ tierColor }};padding:5px 11px;border-radius:999px;\">{{ tierBadge }}<\u002Fdiv>\n            <\u002Fdiv>\n            <div style=\"margin-top:11px;font-size:12.5px;line-height:1.5;color:#8A6A1E;font-weight:500;\">{{ tierExplain }}<\u002Fdiv>\n          <\u002Fdiv>\n\n          <sc-if value=\"{{ showBoost }}\" hint-placeholder-val=\"{{ false }}\">\n            <div style=\"margin-top:14px;width:100%;max-width:400px;background:linear-gradient(135deg,#F6F0FF,#FBF5FF);border:1.5px solid #E6D9FB;border-radius:18px;padding:16px 18px;text-align:left;\">\n              <div style=\"display:flex;align-items:center;gap:9px;margin-bottom:6px;\">\n                <span style=\"font-size:20px;\">💎<\u002Fspan>\n                <span style=\"font-family:'Bricolage Grotesque',sans-serif;font-weight:800;font-size:15.5px;color:#6D28D9;\">Quer um plano ainda mais completo?<\u002Fspan>\n              <\u002Fdiv>\n              <div style=\"font-size:12.5px;line-height:1.5;color:#6D5A86;font-weight:500;\">Responda 3 perguntas bônus e eu adiciono 3 seções ao seu PDF: <b>Plano de Riscos<\u002Fb>, <b>Recursos &amp; Ferramentas<\u002Fb> e <b>Definição de Pronto<\u002Fb>. Sua clareza sobe pro nível máximo. 🚀<\u002Fdiv>\n              <button onclick=\"{{ onBoost }}\" style=\"margin-top:12px;width:100%;border:none;cursor:pointer;background:linear-gradient(135deg,#8B5CF6,#6D28D9);color:#fff;font-family:'Bricolage Grotesque',sans-serif;font-weight:700;font-size:15px;padding:12px;border-radius:14px;box-shadow:0 12px 26px -10px rgba(109,40,217,.6);\">Turbinar meu plano (+clareza) 💎<\u002Fbutton>\n            <\u002Fdiv>\n          <\u002Fsc-if>\n\n          <button onclick=\"{{ onGeneratePDF }}\" style=\"{{ pdfBtnStyle }}\">{{ pdfBtnLabel }}<\u002Fbutton>\n          <button onclick=\"{{ onRestart }}\" style=\"margin-top:14px;background:none;border:none;color:#A8889A;font-weight:700;font-size:13.5px;cursor:pointer;text-decoration:underline;\">Começar um novo projeto<\u002Fbutton>\n        <\u002Fsc-if>\n\n      <\u002Fdiv>\n    <\u002Fsc-if>\n\n  <\u002Fdiv>\n<\u002Fdiv>\n\n<\u002Fx-dc>\n<script type=\"text/x-dc\" data-dc-script=\"\" data-props=\"{&quot;$preview&quot;:{&quot;width&quot;:680,&quot;height&quot;:860}}\">\nclass Component extends DCLogic {\n  constructor(props){\n    super(props);\n    this.scrollRef = React.createRef();\n    this.uid = 0;\n    this.state = {\n      screen:'welcome', phase:'discovery', qIndex:0,\n      messages:[], answers:{}, points:0,\n      method:null, deepenList:[], stageIdx:0,\n      draft:'', inputMode:'none', currentChoices:[], busy:false,\n      generatingPlan:false, plan:null, badges:[], generatingPdf:false\n    };\n\n    this.discovery = [\n      {id:'name', text:'Pra começar: qual o nome do seu projeto e uma frase do que ele é? 🚀', type:'text', ph:'Ex: \"Cafeteria do Bairro — abrir um café aconchegante\"', guide:'Me dê o nome + 1 ou 2 frases. Quanto mais você contextualizar, mais a sua cara fica o plano.'},\n      {id:'problem', text:'Massa! E que problema ele resolve — e pra quem? 🤔', type:'text', ph:'Ex: falta um lugar bom pra trabalhar perto de casa', guide:'Vale 2 a 3 frases: descreva a dor que existe hoje e quem sente essa dor.'},\n      {id:'success', text:'Boa! Agora me ajuda a enxergar o final: como seria o sucesso desse projeto pra você? 🌟', type:'text', ph:'Ex: ter o café cheio nas tardes e 30 clientes fiéis', guide:'Seja concreto: se possível, traga números ou uma cena (“como saberei que deu certo”).'},\n      {id:'audience', text:'Legal! E quem é exatamente o público ou cliente principal? Quanto mais específico, melhor 🎯', type:'text', ph:'Ex: freelancers e estudantes de 20 a 35 anos', guide:'Descreva em 1 ou 2 frases: idade, perfil, contexto. Evite “todo mundo”.'},\n      {id:'deadline', text:'Tem um prazo em mente pra ver isso de pé? ⏳', type:'choice', choices:['Algumas semanas','1 a 3 meses','3 a 6 meses','6+ meses','Sem prazo fixo']},\n      {id:'budget', text:'E em relação a recursos: já tem orçamento ou ferramentas definidos?', type:'choice', choices:['Sim, está definido','Mais ou menos','Ainda não','Não preciso de muito']},\n      {id:'team', text:'Quantas pessoas vão colocar a mão na massa (te incluindo)? 👥', type:'choice', choices:['Só eu','2 a 5','6 a 10','11 a 25','Mais de 25']},\n      {id:'experience', text:'Última dessa etapa: você já tocou um projeto parecido antes? 😊', type:'choice', choices:['Sim, vários','Um ou outro','É minha primeira vez']}\n    ];\n    this.agileQs = [\n      {id:'deliverables', text:'Show! Quais são as principais entregas ou \"pedaços\" do projeto? Pode listar separando por vírgula 🙂', type:'text', ph:'Ex: site, cardápio, divulgação, fornecedores', guide:'Liste de 4 a 7 itens separados por vírgula. Cada item vira uma tarefa no seu plano — quanto mais completo, melhor o backlog.'},\n      {id:'priority', text:'Já tem clareza de qual vem primeiro?', type:'choice', choices:['Sim, sei a ordem','Mais ou menos','Não, preciso de ajuda']},\n      {id:'risk', text:'Pensando com cuidado: qual a maior dúvida ou risco que te preocupa nesse projeto? 😅', type:'text', ph:'Ex: não sei se vai ter procura suficiente', guide:'Conte 1 ou 2 preocupações reais. Isso vira um plano de risco no seu PDF.'},\n      {id:'capacity', text:'Quanto tempo por semana cada pessoa consegue dedicar?', type:'choice', choices:['Algumas horas','Meio período','Período integral','Varia bastante']},\n      {id:'milestones', text:'Tem alguma data ou marco fixo importante? (lançamento, evento, entrega)', type:'text', ph:'Ex: lançar dia 15/08 — ou escreva \"não tenho\"', guide:'Se tiver datas, me passe com mês/dia. Ajuda a montar um cronograma realista.'},\n      {id:'comms', text:'E como vocês preferem acompanhar o progresso?', type:'choice', choices:['Reuniões rápidas','Mensagens / chat','Um quadro visual','Um pouco de tudo']},\n      {id:'successMetric', text:'Por último: como você vai saber, na prática, que está indo bem? 📈', type:'text', ph:'Ex: nº de clientes, vendas por semana, avaliações...', guide:'Me dê 1 a 3 indicadores mensuráveis. Eles viram os KPIs do seu plano.'}\n    ];\n    this.heavyQs = [\n      {id:'deliverables', text:'Quais são as principais fases ou processos do projeto?', type:'text', ph:'Ex: planejamento, execução, controle de qualidade, entrega', guide:'Liste as fases na ordem que fazem sentido, separadas por vírgula. Quanto mais detalhado, melhor o cronograma.'},\n      {id:'approvals', text:'Existem pontos de aprovação obrigatórios entre as fases?', type:'choice', choices:['Sim, vários','Alguns','Não']},\n      {id:'quality', text:'Há métricas de qualidade ou indicadores que precisam ser controlados?', type:'text', ph:'Ex: taxa de erro, prazo, custo, satisfação', guide:'Cite os indicadores que importam, com metas se tiver. Viram seus KPIs no PDF.'},\n      {id:'risk', text:'Existem dependências ou riscos críticos entre as fases?', type:'text', ph:'Ex: a fase 2 só começa quando a 1 for aprovada', guide:'Descreva o que trava o quê, e os riscos mais sérios. Vira um plano de risco.'},\n      {id:'capacity', text:'Quanto tempo a equipe consegue dedicar por semana?', type:'choice', choices:['Algumas horas','Meio período','Período integral','Varia bastante']},\n      {id:'stakeholders', text:'Quem precisa aprovar ou ser mantido informado sobre o andamento?', type:'text', ph:'Ex: diretoria, cliente, órgão regulador...', guide:'Liste pessoas/áreas e o papel de cada uma (aprova? só acompanha?).'}\n    ];\n    this.bonusQs = [\n      {id:'b_risk', text:'Pra deixar seu plano mais robusto: quais são os 2 ou 3 maiores riscos, e o que você faria pra evitar cada um? 🛡️', type:'text', ph:'Ex: pouca procura → fazer pré-venda; atraso de fornecedor → ter um plano B', guide:'Pra cada risco, diga uma ação de prevenção. Isso vira a seção \"Plano de Riscos\" no PDF.'},\n      {id:'b_resources', text:'Que recursos e ferramentas você já tem, e o que ainda precisa conseguir? 🧰', type:'text', ph:'Ex: tenho o ponto e R$5k; preciso de equipamento e um sócio', guide:'Liste o que tem e o que falta. Vira a seção \"Recursos e Ferramentas\".'},\n      {id:'b_definition', text:'Como você define que uma entrega está realmente \"pronta\"? ✅', type:'text', ph:'Ex: testada, revisada por alguém e aprovada pelo cliente', guide:'Descreva seus critérios de qualidade. Vira a \"Definição de Pronto\" no PDF.'}\n    ];\n\n    this.acks = ['Boa! Isso me ajuda demais 🙌','Perfeito, anotado! ✅','Adorei essa resposta 😄','Top! Tô entendendo seu projeto 👀','Show de bola! 🎯','Massa, isso é ouro pra mim 💛','Entendi! Cada vez mais claro 🔍','Maravilha, seguimos! 🚀'];\n\n    this.EDU = {\n      name:{icon:'🧭', title:'Comece pela visão', body:'Todo projeto que dá certo começa sabendo onde quer chegar. A \"visão\" é essa foto do futuro — é ela que vai guiar cada decisão no caminho.'},\n      problem:{icon:'🎯', title:'O que é escopo?', body:'Escopo é tudo que o projeto inclui — e, tão importante quanto, o que ele NÃO inclui. Definir isso cedo evita o clássico \"só mais essa coisinha\" que atrasa tudo.'},\n      success:{icon:'⭐', title:'Objetivo x Metas', body:'O objetivo é o destino final. As metas são os marcos no caminho. Quando uma meta é SMART (específica, mensurável e com prazo), você sabe exatamente quando chegou lá.'},\n      audience:{icon:'🧑‍🤝‍🧑', title:'Conheça quem você serve', body:'Quanto mais claro for o seu público, mais fáceis ficam as decisões. \"Pra todo mundo\" geralmente significa \"pra ninguém\" — foque em quem mais precisa do que você faz.'},\n      deadline:{icon:'⚖️', title:'O triângulo de ferro', body:'Tempo, escopo e custo estão sempre ligados. Apertou o prazo? Normalmente é preciso reduzir o escopo ou somar recursos. Equilibrar os três é a essência da gestão.'},\n      budget:{icon:'💰', title:'Recurso não é só dinheiro', body:'Recurso é tempo, ferramentas e gente também. Saber o que você tem (e o que não tem) evita planos lindos no papel que não cabem na realidade.'},\n      team:{icon:'🧩', title:'Pessoas x Papéis', body:'Mais importante que quantas pessoas é quem faz o quê. Mesmo sozinho(a), você assume vários \"chapéus\": quem decide, quem organiza e quem executa.'},\n      deliverables:{icon:'📋', title:'Isso vira seu backlog', body:'Backlog é a lista priorizada de tudo que precisa ser feito. Quebrar o projeto em pedaços menores faz o gigante virar uma série de passos possíveis.'},\n      priority:{icon:'🔢', title:'Nem tudo é prioridade', body:'Uma dica simples: separe o que é essencial do que \"seria bom ter\". Faça primeiro o que entrega mais valor — assim, se o tempo apertar, o importante já está de pé.'},\n      risk:{icon:'🛡️', title:'Gestão de riscos', body:'Antecipar o que pode dar errado é metade do caminho. Não é pessimismo — é estar preparado. Anote os riscos e pense num plano B para os mais prováveis.'},\n      capacity:{icon:'⏳', title:'Planeje com o tempo real', body:'O erro mais comum é planejar com o tempo que gostaríamos de ter, não o que temos. Seja honesto com a capacidade da equipe — o plano agradece.'},\n      milestones:{icon:'📍', title:'Marcos guiam o ritmo', body:'Marcos são pontos de checagem datados (\"protótipo pronto\", \"lançamento\"). Eles mostram cedo se você está no ritmo certo ou se precisa ajustar.'},\n      comms:{icon:'🔄', title:'Rituais de acompanhamento', body:'Combinar como e quando o time conversa evita ruído. Nos métodos ágeis, esses encontros curtos e regulares se chamam \"cerimônias\" — tipo uma conversa rápida diária.'},\n      successMetric:{icon:'📈', title:'Indicadores (KPIs)', body:'KPI é um indicador-chave que mostra, com fatos, se você está indo bem. Escolha poucos e acompanhe de verdade — número demais vira ruído.'},\n      approvals:{icon:'🚦', title:'Pontos de aprovação (gates)', body:'Em projetos maiores, cada fase só avança quando a anterior é aprovada. Esses \"portões\" garantem qualidade antes de seguir — e evitam retrabalho caro lá na frente.'},\n      quality:{icon:'🎚️', title:'Qualidade se mede', body:'\"Está bom\" é subjetivo. Definir indicadores de qualidade (taxa de erro, prazo, satisfação) transforma opinião em fato e mostra exatamente onde melhorar.'},\n      stakeholders:{icon:'👥', title:'Partes interessadas', body:'Stakeholder é qualquer pessoa afetada ou interessada no projeto. Manter quem importa informado na hora certa evita surpresas e garante apoio quando você precisa.'}\n    };\n\n    this.METHODS = this.buildMethods();\n  }\n\n  buildMethods(){\n    return {\n      scrum:{name:'Scrum',emoji:'🏃',family:'agile',\n        pitch:'Entregas em ciclos curtos chamados sprints, com ajustes constantes a cada poucas semanas.',\n        roles:[['Product Owner','Define e prioriza o que tem mais valor — a \"voz\" de quem vai usar o resultado.'],['Scrum Master','Cuida do processo e remove obstáculos pra equipe fluir.'],['Time de Execução','Quem coloca a mão na massa e entrega os itens.']],\n        cadence:'Trabalhe em sprints de 2 semanas. No início, planeje o que cabe na sprint; no fim, mostre o que ficou pronto (review) e converse sobre o que melhorar (retrospectiva).',\n        dayToDay:['Daily de 15 min: o que fiz, o que farei, o que está travando','Quadro com colunas A fazer / Fazendo / Feito','Review ao fim de cada sprint pra mostrar o resultado','Retrospectiva rápida pra ajustar o jeito de trabalhar'],\n        kpis:['Itens concluídos por sprint (velocidade)','% do que foi planejado e realmente entregue','Satisfação da equipe e de quem recebe o resultado'],\n        glossary:[['Sprint','Ciclo curto de trabalho (geralmente 1–2 semanas) com uma meta clara.'],['Backlog','Lista priorizada de tudo que precisa ser feito.'],['Daily','Reunião diária de 15 min pra alinhar o time.'],['Retrospectiva','Conversa rápida no fim do ciclo pra melhorar o processo.']],\n        badges:[['🏆','Arquiteto Ágil'],['🎯','Mestre do Backlog'],['🏃','Sprinter Iniciado']]},\n      kanban:{name:'Kanban',emoji:'📋',family:'agile',\n        pitch:'Um fluxo contínuo de trabalho visualizado num quadro, sem ciclos fixos — ideal pra demandas que chegam o tempo todo.',\n        roles:[['Dono do Fluxo','Garante que o quadro reflita a realidade e que nada empaque.'],['Equipe de Execução','Puxa um novo item só quando termina o anterior.']],\n        cadence:'Sem sprints: o trabalho flui de forma contínua. Defina um limite de quantos itens podem estar \"Fazendo\" ao mesmo tempo pra não sobrecarregar ninguém.',\n        dayToDay:['Quadro com colunas A fazer / Fazendo / Feito','Limite de itens em andamento (WIP) pra manter o foco','Puxe um item novo só ao concluir outro','Reunião semanal rápida pra olhar o fluxo'],\n        kpis:['Tempo médio pra concluir um item (lead time)','Quantidade entregue por semana (throughput)','Itens parados ou travados no quadro'],\n        glossary:[['Kanban','Método visual de gestão de fluxo de trabalho usando um quadro.'],['WIP','Limite de itens \"em andamento\" ao mesmo tempo.'],['Lead time','Tempo total entre começar e terminar um item.'],['Throughput','Quantidade de itens concluídos num período.']],\n        badges:[['📋','Senhor do Fluxo'],['🎯','Mestre do Backlog'],['⚡','Otimizador']]},\n      lean:{name:'Lean Startup',emoji:'🌱',family:'agile',\n        pitch:'Validar a ideia rápido com o mínimo de esforço, aprendendo com a realidade antes de investir pesado.',\n        roles:[['Empreendedor / Líder','Define as hipóteses a testar e toma as decisões.'],['Equipe Enxuta','Constrói versões mínimas e mede os resultados.']],\n        cadence:'Funcione em ciclos de Construir → Medir → Aprender. Lance algo pequeno (um MVP), veja como as pessoas reagem e ajuste o rumo com base nos dados.',\n        dayToDay:['Liste suas hipóteses mais arriscadas','Construa o teste mais simples possível pra cada uma','Meça com dados reais (não com achismo)','Decida: seguir, ajustar ou mudar de rota'],\n        kpis:['Hipóteses validadas vs. descartadas','Uso real / adesão das pessoas','Custo por aprendizado'],\n        glossary:[['MVP','Versão mínima do produto, suficiente pra aprender com usuários reais.'],['Hipótese','Suposição que você quer testar antes de assumir como verdade.'],['Pivô','Mudança de estratégia baseada no que você aprendeu.'],['Validação','Confirmar (ou não) uma ideia com dados reais.']],\n        badges:[['🌱','Validador'],['🚀','Empreendedor Enxuto'],['🔬','Experimentador']]},\n      design_sprint:{name:'Design Sprint',emoji:'⚡',family:'agile',\n        pitch:'Um processo intenso e criativo pra resolver e testar uma grande ideia em poucos dias.',\n        roles:[['Facilitador','Conduz o processo e mantém o ritmo.'],['Decisor','Tem a palavra final nas escolhas-chave.'],['Equipe Criativa','Gera ideias, prototipa e testa.']],\n        cadence:'Concentre o trabalho em ~5 etapas: Entender o problema, Esboçar soluções, Decidir a melhor, Prototipar e Testar com pessoas reais.',\n        dayToDay:['Mapeie o desafio e o objetivo logo no começo','Gere muitas ideias antes de escolher','Prototipe rápido — não precisa ser perfeito','Teste com usuários reais e anote os aprendizados'],\n        kpis:['Aprendizados gerados','Feedback de usuários no protótipo','Decisões tomadas com clareza'],\n        glossary:[['Design Sprint','Processo de poucos dias pra resolver e testar uma ideia.'],['Protótipo','Versão de teste, rápida e descartável, pra validar a ideia.'],['Teste com usuário','Mostrar o protótipo a pessoas reais e observar a reação.']],\n        badges:[['⚡','Velocista do Design'],['💡','Inovador'],['🎨','Prototipador']]},\n      six_sigma:{name:'Lean Six Sigma',emoji:'📊',family:'heavy',\n        pitch:'Uma abordagem estruturada pra reduzir erros e desperdícios em processos, baseada em dados e melhoria contínua.',\n        roles:[['Patrocinador (Sponsor)','Apoia o projeto e libera recursos.'],['Líder de Melhoria (Belt)','Conduz a análise e as melhorias do processo.'],['Equipe do Processo','Conhece a rotina e implementa as mudanças.']],\n        cadence:'Siga o ciclo DMAIC: Definir o problema, Medir a situação atual, Analisar as causas, Melhorar o processo e Controlar pra manter o ganho.',\n        dayToDay:['Defina claramente o problema e a meta de melhoria','Meça os números atuais antes de mudar qualquer coisa','Investigue as causas-raiz com dados','Implemente melhorias e monitore pra não regredir'],\n        kpis:['Taxa de defeitos ou erros','Variação do processo','Redução de tempo e custo'],\n        glossary:[['DMAIC','Definir, Medir, Analisar, Melhorar e Controlar — as 5 fases do método.'],['Causa-raiz','A origem real de um problema, não só o sintoma.'],['Defeito','Qualquer resultado fora do esperado pelo cliente.'],['Desperdício','Tudo que consome recursos sem gerar valor.']],\n        badges:[['📊','Mestre da Qualidade'],['🎯','Caçador de Desperdício'],['🔍','Analista de Processos']]},\n      waterfall:{name:'Cascata (Waterfall)',emoji:'🪜',family:'heavy',\n        pitch:'Fases sequenciais e bem definidas, uma após a outra — ideal quando o escopo é claro e há dependências fortes.',\n        roles:[['Gerente de Projeto','Coordena prazos, escopo e aprovações entre fases.'],['Responsáveis por Fase','Lideram cada etapa específica.'],['Equipe de Execução','Realiza as entregas de cada fase.']],\n        cadence:'Avance por fases na ordem: Requisitos → Planejamento → Execução → Testes → Entrega. Cada fase só começa quando a anterior é aprovada.',\n        dayToDay:['Documente bem os requisitos antes de começar','Use um cronograma com marcos por fase','Faça aprovação formal ao fim de cada fase','Controle mudanças de escopo com cuidado'],\n        kpis:['Aderência ao cronograma','% do escopo entregue','Marcos cumpridos no prazo'],\n        glossary:[['Cascata','Modelo sequencial onde cada fase segue a anterior.'],['Marco','Ponto importante e datado no cronograma.'],['Escopo','Tudo que o projeto inclui (e o que não inclui).'],['Requisito','O que precisa ser entregue, definido no início.']],\n        badges:[['🪜','Planejador Mestre'],['🗓️','Guardião do Cronograma'],['📐','Estrategista']]},\n      pmbok:{name:'PMBOK / PRINCE2',emoji:'📐',family:'heavy',\n        pitch:'Gestão formal e estruturada de projetos grandes, com governança, controle de riscos e processos bem definidos.',\n        roles:[['Gerente de Projeto','Responsável por planejar, executar e controlar o projeto.'],['Patrocinador','Apoia, aprova e cobra resultados.'],['Partes Interessadas','Todos afetados pelo projeto — precisam ser comunicados.']],\n        cadence:'Organize em grupos de processos: Iniciação, Planejamento, Execução, Monitoramento e Encerramento — com documentação e pontos de controle.',\n        dayToDay:['Mantenha um plano de projeto vivo e atualizado','Acompanhe prazo, custo e escopo de perto','Registre e trate riscos antes que virem problemas','Comunique status às partes interessadas regularmente'],\n        kpis:['Desempenho de prazo e custo (no orçamento?)','Riscos identificados e controlados','Satisfação das partes interessadas'],\n        glossary:[['PMBOK','Guia de boas práticas em gestão de projetos.'],['Parte interessada','Qualquer pessoa afetada ou interessada no projeto.'],['Risco','Evento incerto que pode impactar o projeto.'],['Governança','Conjunto de regras e papéis que orientam as decisões.']],\n        badges:[['📐','Gerente Certificado'],['🛡️','Domador de Riscos'],['📊','Estrategista']]}\n    };\n  }\n\n  componentDidUpdate(){ this.scrollDown(); }\n  scrollDown(){\n    const el = this.scrollRef.current;\n    if(el){ requestAnimationFrame(()=>{ el.scrollTop = el.scrollHeight; }); }\n  }\n\n  fire(opts){ try{ if(window.confetti) window.confetti(Object.assign({particleCount:90,spread:70,origin:{y:.7},colors:['#DB2777','#7C3AED','#F59E0B','#EC4899','#14B8A6']},opts||{})); }catch(e){} }\n\n  push(msg){ const m = Object.assign({id:++this.uid}, msg); this.setState(s=>({messages:[...s.messages, m]})); return m.id; }\n  replace(id, msg){ this.setState(s=>({messages:s.messages.map(m=>m.id===id?Object.assign({id},msg):m)})); }\n  remove(id){ this.setState(s=>({messages:s.messages.filter(m=>m.id!==id)})); }\n  delay(ms){ return new Promise(r=>setTimeout(r,ms)); }\n\n  curQ(){\n    const {phase,qIndex,deepenList} = this.state;\n    if(phase==='discovery') return this.discovery[qIndex];\n    if(phase==='deepen') return deepenList[qIndex];\n    if(phase==='bonus') return this.bonusQs[qIndex];\n    return null;\n  }\n\n  onStart = async () => {\n    this.setState({screen:'chat', stageIdx:0, busy:true});\n    await this.delay(200);\n    this.push({role:'assistant',type:'text',text:'Oi! Eu sou o Ágil 🦊 Vou te ajudar a transformar seu projeto num plano de ação de verdade.'});\n    await this.delay(750);\n    this.push({role:'assistant',type:'text',text:'Funciona assim: a cada resposta sua, você ganha ⭐ pontos de clareza. Quanto mais detalhe você me der, mais completo fica o seu PDF no final. Combinado? 😉'});\n    await this.delay(950);\n    this.push({type:'phase', icon:'🧭', step:'1/4', title:'Descoberta', body:'Nesta primeira etapa eu só quero te conhecer e entender a essência do projeto. Sem pressa — responda com o máximo de detalhe que conseguir.'});\n    await this.delay(900);\n    this.askCurrent();\n  };\n\n  askCurrent(){\n    const q = this.curQ();\n    if(!q) return;\n    this.push({role:'assistant',type:'text',text:q.text});\n    if(q.type==='choice'){\n      this.setState({inputMode:'choice', currentChoices:q.choices, busy:false, draft:''});\n    } else {\n      this.setState({inputMode:'text', currentChoices:[], busy:false, draft:''});\n    }\n  }\n\n  handleAnswer = async (value) => {\n    if(this.state.busy) return;\n    const v = (value||'').trim();\n    if(!v) return;\n    const q = this.curQ();\n    let gained = 15, detailed = false;\n    if(q && q.type==='text'){\n      const words = v.split(/\\s+/).filter(Boolean).length;\n      const bonus = Math.min(15, Math.max(0, words-3)); // up to +15 for richer answers\n      gained = 15 + bonus;\n      detailed = words >= 14;\n    }\n    this.setState(s=>({\n      busy:true, inputMode:'none', draft:'',\n      answers: Object.assign({}, s.answers, q?{[q.id]:v}:{}),\n      points: s.points + gained\n    }));\n    this.push({role:'user', type:'text', text:v});\n    await this.ack(q?q.text:'', v);\n    if(detailed){\n      this.push({role:'assistant', type:'text', text:`Resposta caprichada! +${gained} de clareza ⭐ — é assim que o plano fica completo.`});\n      await this.delay(700);\n    }\n    if(q && this.EDU[q.id]){ await this.showEdu(this.EDU[q.id]); }\n    await this.advance();\n  };\n\n  async showEdu(tip){\n    const tid = this.push({type:'typing'});\n    await this.delay(620);\n    this.remove(tid);\n    this.push({type:'edu', icon:tip.icon, title:tip.title, body:tip.body});\n    this.setState(s=>({points:s.points+10}));\n    await this.delay(950);\n  }\n\n  async ack(question, answer){\n    const tid = this.push({type:'typing'});\n    let line = '';\n    try{\n      const out = await window.claude.complete(`Você é o Ágil, um mentor de projetos super amigável e informal (PT-BR). O usuário respondeu \"${answer}\" para a pergunta \"${question}\". Responda com UMA frase curta (máx 12 palavras), calorosa e encorajadora, com no máximo 1 emoji. NÃO faça outra pergunta. NÃO use aspas.`);\n      line = (out||'').trim().replace(/^[\"']|[\"']$/g,'');\n      if(line.length>90 || line.length<2) line='';\n    }catch(e){ line=''; }\n    if(!line) line = this.acks[Math.floor(Math.random()*this.acks.length)];\n    this.replace(tid, {role:'assistant', type:'text', text:line});\n    await this.delay(450);\n  }\n\n  async advance(){\n    const {phase,qIndex} = this.state;\n    if(phase==='discovery'){\n      if(qIndex < this.discovery.length-1){\n        this.setState(s=>({qIndex:s.qIndex+1}));\n        await this.delay(350);\n        this.askCurrent();\n      } else {\n        await this.classify();\n      }\n    } else if(phase==='deepen'){\n      if(qIndex < this.state.deepenList.length-1){\n        this.setState(s=>({qIndex:s.qIndex+1}));\n        await this.delay(350);\n        this.askCurrent();\n      } else {\n        await this.toFinish();\n      }\n    } else if(phase==='bonus'){\n      if(qIndex < this.bonusQs.length-1){\n        this.setState(s=>({qIndex:s.qIndex+1}));\n        await this.delay(350);\n        this.askCurrent();\n      } else {\n        await this.toFinish();\n      }\n    }\n  }\n\n  onBoost = async () => {\n    this.setState({screen:'chat', phase:'bonus', qIndex:0, busy:true, bonusDone:true});\n    await this.delay(250);\n    this.push({type:'phase', icon:'💎', step:'Bônus', title:'Turbinar o plano', body:'Massa! Vou fazer 3 perguntas extras. Elas adicionam novas seções ao seu PDF — Plano de Riscos, Recursos e Definição de Pronto — e sobem bastante a sua clareza.'});\n    await this.delay(1100);\n    this.askCurrent();\n  };\n\n  async classify(){\n    this.setState({stageIdx:1, busy:true});\n    await this.delay(300);\n    this.push({type:'phase', icon:'🧩', step:'2/4', title:'Análise', body:'Já sei o suficiente sobre o \"o quê\" e o \"pra quem\". Agora vou cruzar suas respostas — tamanho da equipe, prazo e tipo de projeto — pra descobrir qual metodologia combina mais com você.'});\n    await this.delay(1100);\n    const tid = this.push({type:'typing'});\n    const a = this.state.answers;\n    let method = null, reason = '';\n    try{\n      const prompt = `Classifique o projeto em UMA metodologia de gestão. Respostas do usuário:\\n- Nome/descrição: ${a.name}\\n- Problema/público: ${a.problem}\\n- Prazo: ${a.deadline}\\n- Tamanho da equipe: ${a.team}\\nEscolha exatamente uma destas chaves: scrum, kanban, lean, design_sprint, six_sigma, waterfall, pmbok.\\nUse: equipe pequena e escopo iterativo→scrum; fluxo contínuo/atendimento/suporte→kanban; startup/validar ideia/MVP→lean; projeto criativo curto pra explorar uma ideia→design_sprint; processo grande com foco em qualidade/redução de erros→six_sigma; etapas sequenciais rígidas/regulatório→waterfall; projeto grande multi-equipe com governança→pmbok.\\nResponda APENAS JSON válido: {\"method\":\"chave\",\"reason\":\"uma frase em PT-BR informal explicando por que combina, máx 24 palavras\"}`;\n      const out = await window.claude.complete(prompt);\n      const j = this.parseJSON(out);\n      if(j && this.METHODS[j.method]){ method=j.method; reason=(j.reason||'').trim(); }\n    }catch(e){}\n    if(!method){ const r=this.ruleClassify(a); method=r.method; reason=r.reason; }\n    if(!reason){ reason = this.METHODS[method].pitch; }\n    const M = this.METHODS[method];\n    this.remove(tid);\n    this.push({type:'reveal', emoji:M.emoji, methodName:M.name, why:`Pelo que você me contou, seu projeto combina super bem com ${M.name}! ${reason}`});\n    this.fire({particleCount:120, spread:90});\n    this.setState({method, deepenList: M.family==='agile'?this.agileQs:this.heavyQs});\n    this.setState(s=>({points:s.points+30}));\n    await this.delay(1300);\n    this.push({type:'phase', icon:'🛠️', step:'3/4', title:'Detalhes', body:`Agora que sei que o seu caminho é ${M.name}, vou fazer perguntas mais específicas dessa metodologia. É com elas que monto seu backlog, cronograma e metas sob medida.`});\n    await this.delay(1100);\n    this.setState({phase:'deepen', qIndex:0, stageIdx:2});\n    this.askCurrent();\n  }\n\n  ruleClassify(a){\n    const team = a.team||''; const txt = ((a.name||'')+' '+(a.problem||'')).toLowerCase(); const dl=(a.deadline||'').toLowerCase();\n    const big = team==='11 a 25' || team==='Mais de 25';\n    const has = (arr)=>arr.some(w=>txt.includes(w));\n    if(big || has(['processo','produção','fábrica','departament','regulat','qualidade','auditoria','contrato','obra','construç'])){\n      if(has(['regulat','sequenci','obra','construç','contrato','etapas','licenç'])) return {method:'waterfall', reason:'Tem etapas bem definidas e dependências fortes — pede um caminho sequencial e organizado.'};\n      if(has(['qualidade','erro','defeito','desperdíci','processo','redução','produção','fábrica'])) return {method:'six_sigma', reason:'O foco em processo e qualidade pede uma abordagem orientada a dados.'};\n      return {method:'pmbok', reason:'É um projeto grande com várias frentes — pede governança e controle mais formais.'};\n    }\n    if(has(['atendimento','suporte','contínuo','fluxo','demanda','manutenção','operação','rotina'])) return {method:'kanban', reason:'Como o trabalho chega de forma contínua, um fluxo visual encaixa melhor que ciclos fixos.'};\n    if(has(['startup','validar','mvp','hipótese','mercado','negócio','testar ideia','lançar produto','app','aplicativo'])) return {method:'lean', reason:'Dá pra validar rápido com pouco esforço antes de investir pesado.'};\n    if((has(['criativ','ideia','protótipo','inovaç','explorar','design','campanha','conceito'])) && (dl.includes('semana')||dl.includes('sem prazo'))) return {method:'design_sprint', reason:'É criativo e exploratório — uns dias intensos de ideação e teste fazem milagre.'};\n    return {method:'scrum', reason:'Equipe enxuta e entregas que dá pra fatiar em ciclos curtos — a cara do Scrum.'};\n  }\n\n  parseJSON(s){\n    if(!s) return null;\n    try{ return JSON.parse(s); }catch(e){}\n    const m = s.match(/\\{[\\s\\S]*\\}/);\n    if(m){ try{ return JSON.parse(m[0]); }catch(e){} }\n    return null;\n  }\n\n  async toFinish(){\n    this.setState({screen:'finish', stageIdx:3, generatingPlan:true, busy:true});\n    this.fire({particleCount:160, spread:120, startVelocity:45});\n    const plan = await this.buildPlan();\n    const M = this.METHODS[this.state.method];\n    const badges = M.badges.map(b=>({emoji:b[0], label:b[1]}));\n    this.setState(s=>({generatingPlan:false, plan, badges, points:s.points+50}));\n    await this.delay(250);\n    this.fire({particleCount:120, spread:90});\n  }\n\n  async buildPlan(){\n    const a = this.state.answers; const method=this.state.method; const M=this.METHODS[method];\n    const name = this.extractName(a.name);\n    let enrich = null;\n    try{\n      const prompt = `Você monta planos de ação de projetos (PT-BR, claro e profissional, mas acessível). Dados:\\n- Projeto: ${a.name}\\n- Problema/público: ${a.problem}\\n- Prazo: ${a.deadline}\\n- Equipe: ${a.team}\\n- Entregas/fases: ${a.deliverables||'não informado'}\\n- Metodologia: ${M.name}\\nResponda APENAS JSON válido e conciso:\\n{\"vision\":\"1 frase de visão inspiradora\",\"objective\":\"1 frase de objetivo central\",\"smart\":[\"meta SMART 1\",\"meta SMART 2\",\"meta SMART 3\"],\"backlog\":[{\"item\":\"entrega\",\"priority\":\"Alta|Média|Baixa\"}]}\\nGere de 4 a 7 itens de backlog a partir das entregas/fases informadas, priorizados. Metas SMART curtas, mensuráveis e realistas.`;\n      const out = await window.claude.complete(prompt);\n      enrich = this.parseJSON(out);\n    }catch(e){}\n    const backlog = (enrich && Array.isArray(enrich.backlog) && enrich.backlog.length) ? enrich.backlog.map(b=>({item:b.item||'Item', priority:b.priority||'Média'})) : this.fallbackBacklog(a);\n    const smart = (enrich && Array.isArray(enrich.smart) && enrich.smart.length) ? enrich.smart.slice(0,3) : this.fallbackSmart(a, name);\n    const vision = (enrich && enrich.vision) ? enrich.vision : `Tornar \"${name}\" uma realidade, resolvendo de forma concreta: ${a.problem||'a necessidade que motivou o projeto'}.`;\n    const objective = (enrich && enrich.objective) ? enrich.objective : `Entregar ${name} dentro do prazo de \"${a.deadline}\", com a qualidade esperada por quem vai usar o resultado.`;\n    // clarity tier + bonus content\n    const textIds = Object.keys(a).filter(k=>typeof a[k]==='string');\n    const avgWords = textIds.length ? textIds.reduce((s,k)=>s+a[k].split(/\\s+/).filter(Boolean).length,0)/textIds.length : 0;\n    const hasBonus = !!(a.b_risk || a.b_resources || a.b_definition);\n    let tier = 'Essencial';\n    if(hasBonus) tier = 'Detalhado';\n    else if(avgWords >= 8) tier = 'Completo';\n    const bonus = hasBonus ? {risks:a.b_risk||'', resources:a.b_resources||'', definition:a.b_definition||''} : null;\n    return {\n      name, method, M, answers:a,\n      date: new Date().toLocaleDateString('pt-BR',{day:'2-digit',month:'long',year:'numeric'}),\n      vision, objective, smart, backlog,\n      nextSteps: this.nextSteps(M),\n      tier, bonus, points: this.state.points\n    };\n  }\n\n  extractName(s){\n    if(!s) return 'Meu Projeto';\n    let n = s.split(/[—\\-–:]/)[0].trim();\n    if(n.length<2 || n.length>48) n = s.trim().slice(0,48);\n    return n;\n  }\n  fallbackBacklog(a){\n    const raw = a.deliverables||'';\n    let items = raw.split(/[,;\\n]| e |\\/| \\+ /).map(x=>x.trim()).filter(x=>x.length>1);\n    if(!items.length) items=['Definir escopo e requisitos','Preparar os recursos necessários','Executar a primeira entrega','Revisar e ajustar com feedback'];\n    const pr = ['Alta','Alta','Média','Média','Baixa','Baixa','Baixa'];\n    return items.slice(0,7).map((it,i)=>({item: it.charAt(0).toUpperCase()+it.slice(1), priority: pr[i]||'Baixa'}));\n  }\n  fallbackSmart(a, name){\n    return [\n      `Concluir a primeira entrega de ${name} em até 2 semanas após o início.`,\n      `Entregar 100% do escopo prioritário dentro do prazo de \"${a.deadline}\".`,\n      `Manter a equipe (${a.team}) alinhada com pelo menos 1 acompanhamento por semana.`\n    ];\n  }\n  nextSteps(M){\n    const base = M.family==='agile'\n      ? ['Liste todas as entregas como itens do seu backlog','Priorize os 3 itens mais importantes pra começar','Defina a duração do seu primeiro ciclo de trabalho','Agende um momento rápido de acompanhamento com a equipe','Comece pela entrega de maior valor — feito é melhor que perfeito']\n      : ['Documente claramente o escopo e os requisitos','Mapeie as fases e os pontos de aprovação','Defina os indicadores que você vai acompanhar','Monte o cronograma com os marcos principais','Comunique o plano às pessoas envolvidas'];\n    return base;\n  }\n\n  // ---------- PDF ----------\n  onGeneratePDF = async () => {\n    if(this.state.generatingPdf) return;\n    this.setState({generatingPdf:true});\n    try{\n      await this.ensureLib();\n      const wrap = document.createElement('div');\n      wrap.style.cssText='position:fixed;left:0;top:0;z-index:-1;width:794px;background:#fff;';\n      const el = document.createElement('div');\n      el.style.cssText='width:794px;background:#fff;';\n      el.innerHTML = this.docHTML(this.state.plan);\n      wrap.appendChild(el);\n      document.body.appendChild(wrap);\n      await this.delay(250);\n      const opt = {\n        margin:0,\n        filename:`Plano de Ação - ${this.state.plan.name}.pdf`,\n        image:{type:'jpeg',quality:0.98},\n        html2canvas:{scale:2, useCORS:true, backgroundColor:'#ffffff'},\n        jsPDF:{unit:'mm', format:'a4', orientation:'portrait'},\n        pagebreak:{mode:['css','legacy']}\n      };\n      await window.html2pdf().set(opt).from(el).save();\n      document.body.removeChild(wrap);\n    }catch(e){ console.warn('pdf error', e); alert('Não consegui gerar o PDF agora. Tente novamente em instantes.'); }\n    this.setState({generatingPdf:false});\n  };\n\n  ensureLib(){\n    return new Promise((res,rej)=>{\n      let t=0; const iv=setInterval(()=>{ if(window.html2pdf){clearInterval(iv);res();} else if((t+=100)>8000){clearInterval(iv);rej(new Error('lib timeout'));} },100);\n    });\n  }\n\n  onRestart = () => {\n    this.setState({screen:'welcome', phase:'discovery', qIndex:0, messages:[], answers:{}, points:0, method:null, deepenList:[], stageIdx:0, draft:'', inputMode:'none', currentChoices:[], busy:false, generatingPlan:false, plan:null, badges:[], generatingPdf:false, bonusDone:false});\n  };\n\n  docHTML(p){\n    const A='#DB2777', INK='#1F1620', MUT='#6E5764', LINE='#ECE0E8', PAGE='794px';\n    const page = (inner, first)=>`<div style=\"width:${PAGE};padding:56px 58px;background:#fff;${first?'':'page-break-before:always;'}box-sizing:border-box;font-family:'Plus Jakarta Sans',Arial,sans-serif;color:${INK};\">${inner}<\u002Fdiv>`;\n    const why = (t)=>`<div style=\"margin-top:16px;background:#FBF1F6;border-left:4px solid ${A};border-radius:0 12px 12px 0;padding:14px 18px;\"><div style=\"font-weight:800;font-size:12px;letter-spacing:.04em;color:${A};text-transform:uppercase;margin-bottom:5px;\">Por que isso importa<\u002Fdiv><div style=\"font-size:13.5px;line-height:1.6;color:${MUT};\">${t}<\u002Fdiv><\u002Fdiv>`;\n    const head = (num,title)=>`<div style=\"display:flex;align-items:center;gap:14px;margin-bottom:18px;\"><div style=\"width:38px;height:38px;border-radius:11px;background:${A};color:#fff;font-family:'Bricolage Grotesque',sans-serif;font-weight:800;font-size:18px;display:flex;align-items:center;justify-content:center;flex:none;\">${num}<\u002Fdiv><h2 style=\"font-family:'Bricolage Grotesque',sans-serif;font-weight:800;font-size:23px;letter-spacing:-.02em;margin:0;color:${INK};\">${title}<\u002Fh2><\u002Fdiv>`;\n    const sec = (num,title,body,whyText)=>`<div style=\"page-break-inside:avoid;margin-bottom:34px;\">${head(num,title)}${body}${whyText?why(whyText):''}<\u002Fdiv>`;\n    const li = (items,style)=>`<ul style=\"margin:0;padding-left:0;list-style:none;display:flex;flex-direction:column;gap:9px;\">${items.map(t=>`<li style=\"font-size:14px;line-height:1.55;color:${INK};padding-left:24px;position:relative;\">${style||`<span style=\"position:absolute;left:0;top:1px;color:${A};font-weight:800;\">›<\u002Fspan>`}${t}<\u002Fli>`).join('')}<\u002Ful>`;\n    const prColor = {Alta:'#DB2777',Média:'#F59E0B',Baixa:'#14B8A6'};\n\n    // cover\n    const cover = `<div style=\"width:${PAGE};height:1100px;box-sizing:border-box;background:linear-gradient(150deg,#7C3AED 0%,#DB2777 100%);color:#fff;padding:72px 58px;display:flex;flex-direction:column;font-family:'Plus Jakarta Sans',Arial,sans-serif;\">\n      <div style=\"display:flex;align-items:center;gap:12px;\"><div style=\"width:44px;height:44px;border-radius:13px;background:rgba(255,255,255,.18);display:flex;align-items:center;justify-content:center;font-size:24px;\">🦊<\u002Fdiv><span style=\"font-family:'Bricolage Grotesque',sans-serif;font-weight:800;font-size:20px;\">Meu Projeto<\u002Fspan><\u002Fdiv>\n      <div style=\"margin-top:auto;\">\n        <div style=\"display:inline-block;background:rgba(255,255,255,.18);padding:7px 16px;border-radius:999px;font-weight:700;font-size:13px;letter-spacing:.05em;text-transform:uppercase;\">Plano de Ação<\u002Fdiv>\n        <h1 style=\"font-family:'Bricolage Grotesque',sans-serif;font-weight:800;font-size:50px;line-height:1.05;letter-spacing:-.03em;margin:22px 0 0;\">${this.esc(p.name)}<\u002Fh1>\n        <div style=\"margin-top:28px;display:flex;align-items:center;gap:12px;font-size:17px;\"><span style=\"font-size:30px;\">${p.M.emoji}<\u002Fspan><span style=\"font-weight:700;\">Metodologia: ${p.M.name}<\u002Fspan><\u002Fdiv>\n      <\u002Fdiv>\n      <div style=\"margin-top:auto;display:flex;justify-content:space-between;align-items:flex-end;font-size:13px;opacity:.9;border-top:1px solid rgba(255,255,255,.25);padding-top:18px;\">\n        <span>Gerado em ${p.date}<\u002Fspan><span>Feito com o Ágil 🦊 · Meu Projeto<\u002Fspan>\n      <\u002Fdiv><\u002Fdiv>`;\n\n    const s2 = sec(1,'Visão, Objetivo e Metas',\n      `<div style=\"font-size:14px;line-height:1.6;\"><b style=\"color:${A};\">Visão.<\u002Fb> ${this.esc(p.vision)}<\u002Fdiv><div style=\"font-size:14px;line-height:1.6;margin-top:8px;\"><b style=\"color:${A};\">Objetivo central.<\u002Fb> ${this.esc(p.objective)}<\u002Fdiv><div style=\"font-weight:800;font-size:13px;margin:16px 0 8px;color:${INK};\">Metas SMART<\u002Fdiv>${li(p.smart.map(this.esc))}`,\n      'Metas SMART são Específicas, Mensuráveis, Atingíveis, Relevantes e com prazo (Temporais). Elas transformam um desejo vago num alvo claro — você sabe exatamente o que perseguir e quando terá chegado lá.');\n\n    const s3 = sec(2,'Metodologia Recomendada',\n      `<div style=\"display:flex;gap:14px;align-items:center;background:#FBF1F6;border-radius:14px;padding:16px 18px;margin-bottom:14px;\"><span style=\"font-size:34px;\">${p.M.emoji}<\u002Fspan><div><div style=\"font-family:'Bricolage Grotesque',sans-serif;font-weight:800;font-size:20px;\">${p.M.name}<\u002Fdiv><div style=\"font-size:13px;color:${MUT};margin-top:2px;\">${p.M.pitch}<\u002Fdiv><\u002Fdiv><\u002Fdiv><div style=\"font-size:14px;line-height:1.6;\">Essa metodologia foi escolhida porque seu projeto tem equipe de \"${this.esc(p.answers.team)}\", prazo \"${this.esc(p.answers.deadline)}\" e o perfil que você descreveu se encaixa nela.<\u002Fdiv>`,\n      'Escolher a metodologia certa evita esforço desperdiçado: ela define o ritmo, os papéis e as ferramentas que melhor combinam com o tamanho e a natureza do seu projeto.');\n\n    const s4 = sec(3,'Backlog — Lista de Entregas Priorizada',\n      `<div style=\"display:flex;flex-direction:column;gap:8px;\">${p.backlog.map(b=>`<div style=\"display:flex;align-items:center;gap:12px;border:1px solid ${LINE};border-radius:11px;padding:11px 14px;\"><span style=\"font-size:11px;font-weight:800;color:#fff;background:${prColor[b.priority]||'#999'};padding:4px 9px;border-radius:999px;flex:none;\">${b.priority}<\u002Fspan><span style=\"font-size:14px;\">${this.esc(b.item)}<\u002Fspan><\u002Fdiv>`).join('')}<\u002Fdiv>`,\n      'O backlog é a lista priorizada de tudo que precisa ser feito. Mantenha-o vivo: revise as prioridades sempre que algo mudar e sempre puxe o item mais importante primeiro. Itens de prioridade Alta entregam mais valor logo no início.');\n\n    const s5 = sec(4,'Divisão de Equipe e Papéis',\n      `<div style=\"display:flex;flex-direction:column;gap:10px;\">${p.M.roles.map(r=>`<div style=\"border:1px solid ${LINE};border-radius:11px;padding:12px 15px;\"><div style=\"font-weight:800;font-size:14px;color:${A};\">${r[0]}<\u002Fdiv><div style=\"font-size:13px;line-height:1.5;color:${MUT};margin-top:3px;\">${r[1]}<\u002Fdiv><\u002Fdiv>`).join('')}<\u002Fdiv>${p.answers.team==='Só eu'?`<div style=\"font-size:13px;color:${MUT};margin-top:12px;font-style:italic;\">Como você está sozinho(a), vai acumular esses papéis — o importante é ter consciência de \"qual chapéu\" está usando em cada momento.<\u002Fdiv>`:''}`,\n      'Mesmo numa equipe pequena, deixar claro quem decide, quem organiza e quem executa evita confusão e retrabalho. Os papéis são funções, não necessariamente pessoas diferentes.');\n\n    const s6 = sec(5,'Cronograma e Ritmo de Trabalho',\n      `<div style=\"font-size:14px;line-height:1.6;\">${this.esc(p.M.cadence)}<\u002Fdiv>`,\n      'Um ritmo definido cria previsibilidade. Saber quando as coisas acontecem ajuda todo mundo a se organizar e a perceber cedo se algo está atrasando.');\n\n    const s7 = sec(6,'Como Gerenciar no Dia a Dia',\n      li(p.M.dayToDay.map(this.esc)),\n      'A gestão acontece nos pequenos hábitos diários, não num documento que ninguém abre. Essas práticas simples mantêm o projeto visível e sob controle sem virar burocracia.');\n\n    const s8 = sec(7,'Indicadores de Sucesso',\n      li(p.M.kpis.map(this.esc)),\n      'Indicadores (KPIs) te dizem, com fatos, se o projeto está indo bem — antes que seja tarde para corrigir. Escolha poucos e acompanhe de verdade.');\n\n    const s9 = sec(8,'Próximos Passos — Primeiros 7 Dias',\n      `<div style=\"display:flex;flex-direction:column;gap:9px;\">${p.nextSteps.map(t=>`<div style=\"display:flex;align-items:center;gap:11px;font-size:14px;\"><span style=\"width:20px;height:20px;border:2px solid ${A};border-radius:6px;flex:none;display:inline-block;\"><\u002Fspan><span>${this.esc(t)}<\u002Fspan><\u002Fdiv>`).join('')}<\u002Fdiv>`,\n      'Um plano só vira realidade quando você dá o primeiro passo. Esse checklist é o seu impulso inicial: pequeno, concreto e possível de começar hoje.');\n\n    const glos = p.M.glossary.concat([['KPI','Indicador-chave de desempenho — uma métrica que mostra se você está no caminho certo.'],['Marco','Um ponto importante e datado dentro do projeto.']]);\n\n    // optional bonus sections (only when clarity was boosted)\n    let bonusSecs = '', bonusPages = '', glossNum = 9;\n    if(p.bonus){\n      const toLines = (txt)=>{\n        const parts = String(txt).split(/[\\n;]|(?:,(?=\\s*[A-ZÀ-Ú]))/).map(x=>x.trim()).filter(x=>x.length>1);\n        return parts.length>1 ? li(parts.map(this.esc)) : `<div style=\"font-size:14px;line-height:1.6;\">${this.esc(txt)}<\u002Fdiv>`;\n      };\n      const bs1 = sec(9,'Plano de Riscos',\n        toLines(p.bonus.risks||'Riscos a mapear conforme o projeto avança.'),\n        'Riscos não somem por serem ignorados. Listar o que pode dar errado — e uma ação de prevenção para cada — é o que separa quem reage no susto de quem está preparado.');\n      const bs2 = sec(10,'Recursos e Ferramentas',\n        toLines(p.bonus.resources||'Recursos a definir.'),\n        'Saber o que você já tem e o que ainda falta evita travar no meio do caminho. É aqui que o plano encontra a realidade de tempo, dinheiro e ferramentas.');\n      const bs3 = sec(11,'Definição de \"Pronto\"',\n        toLines(p.bonus.definition||'Critérios de conclusão a combinar com o time.'),\n        'Sem um critério claro de \"pronto\", cada um entende a conclusão de um jeito. Definir isso antes evita retrabalho e discussões sobre se algo está ou não finalizado.');\n      bonusSecs = bs1; bonusPages = page(bs2+bs3, false); glossNum = 12;\n    }\n    const s10 = sec(glossNum,'Glossário Rápido',\n      `<div style=\"display:flex;flex-direction:column;gap:9px;\">${glos.map(g=>`<div style=\"font-size:13.5px;line-height:1.55;\"><b style=\"color:${A};\">${this.esc(g[0])}:<\u002Fb> ${this.esc(g[1])}<\u002Fdiv>`).join('')}<\u002Fdiv>`,\n      null);\n\n    return cover + page(s2+s3, false) + page(s4+s5, false) + page(s6+s7, false) + page(s8+s9, false) + (p.bonus?page(bonusSecs, false)+bonusPages:'') + page(s10, false);\n  }\n  esc(s){ return String(s==null?'':s).replace(/&/g,'&amp;').replace(/<\u002Fg,'&lt;').replace(/>/g,'&gt;'); }\n\n  onDraft = (e)=>{ this.setState({draft:e.target.value}); };\n  onDraftKey = (e)=>{ if(e.key==='Enter' && !e.shiftKey){ e.preventDefault(); this.handleAnswer(this.state.draft); } };\n  onSend = ()=>{ this.handleAnswer(this.state.draft); };\n\n  renderVals(){\n    const s = this.state;\n    const M = s.method ? this.METHODS[s.method] : null;\n    const messagesView = s.messages.map(m=>({\n      id:m.id,\n      isAssistant: m.role==='assistant' && m.type==='text',\n      isUser: m.role==='user' && m.type==='text',\n      isTyping: m.type==='typing',\n      isReveal: m.type==='reveal',\n      isEdu: m.type==='edu',\n      isPhase: m.type==='phase',\n      text:m.text, emoji:m.emoji, methodName:m.methodName, why:m.why,\n      icon:m.icon, title:m.title, body:m.body, step:m.step\n    }));\n\n    const totalQ = this.discovery.length + (s.deepenList.length||6);\n    const answered = Object.keys(s.answers).length;\n    const pct = s.screen==='finish' ? 100 : Math.min(100, Math.round((answered/totalQ)*92) + (s.stageIdx>=1?4:0));\n    const barFillStyle = `height:100%;width:${pct}%;border-radius:999px;background:linear-gradient(90deg,#EC4899,#DB2777);transition:width .5s cubic-bezier(.4,0,.2,1);`;\n\n    const stageDefs = [['🧭','Descoberta'],['🧩','Análise'],['🛠️','Detalhes'],['🏆','Pronto!']];\n    const stages = stageDefs.map((d,i)=>{\n      const done = i < s.stageIdx, active = i === s.stageIdx;\n      const bg = done ? 'linear-gradient(135deg,#EC4899,#BE185D)' : active ? '#FCE7F0' : '#F4ECF0';\n      const fg = done ? '#fff' : active ? '#DB2777' : '#C9B8C2';\n      return {\n        icon:d[0], label:d[1],\n        dotStyle:`width:30px;height:30px;border-radius:10px;background:${bg};display:flex;align-items:center;justify-content:center;font-size:15px;${active?'box-shadow:0 0 0 3px rgba(236,72,153,.18);':''}filter:${done||active?'none':'grayscale(.4)'};opacity:${done||active?1:.55};transition:all .3s ease;color:${fg};`,\n        labelStyle:`font-size:10.5px;font-weight:700;color:${active?'#BE185D':done?'#8A6677':'#C9B8C2'};white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100%;`\n      };\n    });\n\n    const choices = (s.currentChoices||[]).map(c=>({label:c, onClick:()=>this.handleAnswer(c)}));\n    const curQ = this.curQ();\n\n    // live detail meter for text answers\n    const dWords = (s.draft||'').split(/\\s+/).filter(Boolean).length;\n    const dPct = Math.min(100, Math.round(dWords/16*100));\n    let detailLabel = 'Capriche nos detalhes', detailColor = '#C9A1B6';\n    if(dWords>=14){ detailLabel='Resposta rica! ⭐'; detailColor='#16A34A'; }\n    else if(dWords>=6){ detailLabel='Bom — pode detalhar mais'; detailColor='#DB2777'; }\n    else if(dWords>=1){ detailLabel='Continue…'; detailColor='#E08AAC'; }\n    const detailBarStyle = `height:100%;width:${dPct}%;border-radius:999px;background:linear-gradient(90deg,#A78BFA,#DB2777);transition:width .25s ease;`;\n\n    // clarity tier (from plan)\n    const tier = (s.plan && s.plan.tier) || 'Completo';\n    const tierMap = {\n      'Essencial':{color:'#C08A38', badge:'BÁSICO', explain:'Seu plano cobre o essencial. Respostas mais detalhadas (ou as perguntas bônus) deixam o PDF bem mais rico.'},\n      'Completo':{color:'#DB2777', badge:'COMPLETO', explain:'Mandou bem nos detalhes! Seu PDF traz as 10 seções completas. Dá pra subir pro nível máximo com as perguntas bônus.'},\n      'Detalhado':{color:'#6D28D9', badge:'MÁXIMO', explain:'Plano no nível máximo! 🎉 Seu PDF inclui as seções bônus de Riscos, Recursos e Definição de Pronto.'}\n    };\n    const tinfo = tierMap[tier] || tierMap['Completo'];\n    const showBoost = (s.screen==='finish' && !s.generatingPlan && !(s.plan && s.plan.bonus));\n\n    const sendEnabled = !s.busy && (s.draft||'').trim().length>0;\n    const sendStyle = `flex:none;width:46px;height:46px;border-radius:14px;border:none;cursor:${sendEnabled?'pointer':'default'};font-size:17px;color:#fff;background:${sendEnabled?'linear-gradient(135deg,#EC4899,#BE185D)':'#E7CBDB'};box-shadow:${sendEnabled?'0 8px 18px -8px rgba(190,24,93,.6)':'none'};transition:all .15s ease;display:flex;align-items:center;justify-content:center;`;\n\n    const pdfBtnStyle = `margin-top:26px;border:none;cursor:pointer;background:linear-gradient(135deg,#EC4899,#BE185D);color:#fff;font-family:'Bricolage Grotesque',sans-serif;font-weight:700;font-size:17px;padding:16px 30px;border-radius:18px;box-shadow:0 16px 34px -10px rgba(190,24,93,.6);opacity:${s.generatingPdf?.7:1};transition:transform .15s ease;`;\n\n    return {\n      showHeader: s.screen!=='welcome',\n      isWelcome: s.screen==='welcome',\n      isChat: s.screen==='chat',\n      isFinish: s.screen==='finish',\n      generatingPlan: s.generatingPlan,\n      planReady: s.screen==='finish' && !s.generatingPlan,\n      messagesView,\n      points: s.points,\n      barFillStyle, stages,\n      showChoices: s.inputMode==='choice',\n      showTextInput: s.inputMode==='text',\n      choices,\n      draft: s.draft,\n      inputPlaceholder: (curQ && curQ.ph) ? curQ.ph : 'Escreva sua resposta…',\n      hasGuide: !!(curQ && curQ.guide),\n      inputGuide: (curQ && curQ.guide) ? curQ.guide : '',\n      detailBarStyle, detailColor, detailLabel,\n      onDraft:this.onDraft, onDraftKey:this.onDraftKey, onSend:this.onSend, sendStyle,\n      onStart:this.onStart, onGeneratePDF:this.onGeneratePDF, onRestart:this.onRestart, onBoost:this.onBoost,\n      scrollRef:this.scrollRef,\n      badges: s.badges,\n      planName: s.plan ? s.plan.name : '',\n      planMethod: M ? M.name : '',\n      planTier: tier, tierColor: tinfo.color, tierBadge: tinfo.badge, tierExplain: tinfo.explain,\n      showBoost,\n      pdfBtnStyle,\n      pdfBtnLabel: s.generatingPdf ? 'Gerando seu PDF…' : 'Baixar meu Plano de Ação em PDF 🚀'\n    };\n  }\n}\n<\u002Fscript>\n\n\n<\u002Fbody><\u002Fhtml>"
  </script>
</body>
</html>